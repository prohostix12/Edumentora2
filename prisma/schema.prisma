generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model EnquiryList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("enquiry_list")
}

model Gallery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  section   String
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery")
}

model University {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  location     String
  description  String
  mainImage    String?
  certificates String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("universities")
}

model Contact {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  department String
  lanphone   String
  mob        String
  email      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("contacts")
}

type BlogSection {
  subHeading String
  subPara    String
}

model Blog {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  date       DateTime
  category   String
  sectionDis String
  mainImage  String?
  mainDis    BlogSection[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  comments   Comment[]

  @@map("blogs")
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  website   String?
  content   String
  createdAt DateTime @default(now())
  
  blogId    String   @db.ObjectId
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Program {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  topic       String   @default("General")
  heroImage   String?
  heading     String
  subHeading  String?
  paragraph   String
  blocks      Json[]   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programs")
}
