generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model EnquiryList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("enquiry_list")
}

model Gallery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  section   String
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery")
}

model University {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  location     String
  description  String
  mainImage    String?
  certificates String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("universities")
}

model Contact {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  department String
  lanphone   String
  mob        String
  email      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("contacts")
}
